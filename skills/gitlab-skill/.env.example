# Secrets and local overrides only.
# Non-secret gitlab-skill settings live in src/common/config/settings/.

# Secrets and local overrides only. Repository list lives in settings.toml.

GITLAB_AVGR_TOKEN=

# Optional. Enable only if GITLAB_QUERY_PLANNER_PROVIDER = "openai".
# GitHub Actions: provide OPENAI_API_KEY from GitHub Secrets.
OPENAI_API_KEY=

# GitHub Actions: provide proxy values from GitHub Environment variables.
PROXY=
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
API_MODE=
NO_PROXY=localhost,127.0.0.1,nginx,n8n-vn1,keycloak