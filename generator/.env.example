# Secrets and local overrides only.
# Non-secret generator settings live in src/common/config/settings/.

# Optional local overrides:
# API_MODE=DEV
# API_PORT=8010
# AUTH_CONTEXT_URL=http://localhost:8030/v1/auth/context

# LLM / external APIs.
# GitHub Actions: provide OPENAI_API_KEY from GitHub Secrets.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GIGACHAT_API_KEY=

# Optional generated file storage overrides:
# GENERATED_FILE_DB_PATH=./data/generated_files.sqlite3
# GENERATED_FILE_TTL_SECONDS=10800

# Optional outbound proxy with credentials.
# GitHub Actions: provide proxy values from GitHub Environment variables.
# PROXY is used directly by the backend LLM HTTP client.
PROXY=
ALL_PROXY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,nginx,n8n-vn1,keycloak