# Secrets and local overrides only.
# Non-secret api-gateway settings live in src/common/config/settings/.

API_MODE=PROD
API_PORT=8000
SSE_EVENT_SET=set

GENERATOR_BASE_URL=http://localhost:8010

AUTH_CONTEXT_URL=http://localhost:8030/v1/auth/context
AUTH_REQUIRED_ROLES=[]

ORCHESTRATOR_SKILL_BASE_URL=http://localhost:8020
GITLAB_SKILL_BASE_URL=http://localhost:8022

# GitHub Actions:
# - OPENAI_API_KEY must be provided from GitHub Secrets.
# - Proxy values must be provided from GitHub Environment variables.
OPENAI_API_KEY=
# PROXY=
# ALL_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=